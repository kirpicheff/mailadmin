# Database Connection
# Format: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=user:password@tcp(127.0.0.1:3306)/mailadmin?charset=utf8mb4&parseTime=True&loc=Local

# JWT Security
# Ensure this is a strong, random string in production (32+ chars)
JWT_SECRET=your-random-secret-key-goes-here

# Server Configuration
LISTEN_ADDR=:8080

# CORS Configuration
# For production, set this to your frontend URL
CORS_ORIGIN=http://localhost:5173
# System Paths
# MAIL_ROOT is the base directory for mailboxes (e.g. /var/vmail or /data/mail)
MAIL_ROOT=/data/mail
# SIEVE_ROOT is the base directory for Sieve scripts
SIEVE_ROOT=/data/sieve
# LOG_PATH is the main mail log file
LOG_PATH=/var/log/mail.log
